{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rootcause.ai/schemas/aie/incident.schema.json",
  "title": "AIE Incident",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "metadata",
    "alert",
    "deployment",
    "metrics",
    "kubernetes_events",
    "logs",
    "ground_truth"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "alert": {
      "$ref": "#/$defs/alert"
    },
    "deployment": {
      "$ref": "#/$defs/deployment"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/metric_series"
      }
    },
    "kubernetes_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/kubernetes_event"
      }
    },
    "logs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/log_entry"
      }
    },
    "ground_truth": {
      "$ref": "#/$defs/ground_truth"
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "company",
        "environment",
        "region",
        "detected_at"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "company": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "detected_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "severity",
        "service",
        "started_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "service",
        "version",
        "deployed_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "previous_version": {
          "type": "string"
        },
        "commit_sha": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "deployed_at": {
          "type": "string",
          "format": "date-time"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "metric_series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "unit",
        "points"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/metric_point"
          }
        }
      }
    },
    "metric_point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "value"
      ],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "value": {
          "type": "number"
        }
      }
    },
    "kubernetes_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "timestamp",
        "type",
        "reason",
        "pod",
        "container",
        "message",
        "restart_count"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string"
        },
        "pod": {
          "type": "string",
          "minLength": 1
        },
        "container": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "restart_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "log_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "timestamp",
        "level",
        "service",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "level": {
          "type": "string",
          "minLength": 1
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_cause_code",
        "summary"
      ],
      "properties": {
        "root_cause_code": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
